{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vai-arena/strategy.schema.json",
  "title": "VAI 아레나 전략 파일 v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "team", "slot", "version", "name", "philosophy",
               "submitted_at", "universe", "entry", "position", "exit", "risk"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^(GPT|GEM|CLA)-(0[1-9]|10)_[0-9]{1,3}$"},
    "team": {"enum": ["GPT", "GEM", "CLA"]},
    "slot": {"type": "integer", "minimum": 1, "maximum": 10},
    "version": {"type": "integer", "minimum": 0, "maximum": 999},
    "replaces": {"type": ["string", "null"], "pattern": "^(GPT|GEM|CLA)-(0[1-9]|10)_[0-9]{1,3}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 40},
    "philosophy": {"type": "string", "minLength": 10, "maxLength": 300},
    "submitted_at": {"type": "string", "format": "date-time"},

    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markets", "min_value_ma20"],
      "properties": {
        "markets": {"type": "array", "minItems": 1, "uniqueItems": true,
                    "items": {"enum": ["KOSPI", "KOSDAQ"]}},
        "min_value_ma20": {"type": "number", "minimum": 1000000000},
        "price_min": {"type": ["number", "null"], "minimum": 0},
        "price_max": {"type": ["number", "null"], "minimum": 0},
        "marcap_min": {"type": ["number", "null"], "minimum": 0},
        "marcap_max": {"type": ["number", "null"], "minimum": 0},
        "filters": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/condition"}}
      }
    },

    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logic", "conditions", "rank", "max_new_per_day"],
      "properties": {
        "logic": {"enum": ["all", "any"]},
        "conditions": {"type": "array", "minItems": 1, "maxItems": 10,
                       "items": {"$ref": "#/$defs/condition"}},
        "rank": {
          "type": "object", "additionalProperties": false,
          "required": ["by", "order"],
          "properties": {"by": {"$ref": "#/$defs/ref"}, "order": {"enum": ["desc", "asc"]}}
        },
        "max_new_per_day": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },

    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_positions", "sizing", "entry_order", "split_buy"],
      "properties": {
        "max_positions": {"type": "integer", "minimum": 1, "maximum": 20},
        "sizing": {"enum": ["all_in", "equal", "fixed_pct"]},
        "pct_per_position": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100},
        "entry_order": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"enum": ["open", "limit"]},
            "offset_pct": {"type": ["number", "null"], "minimum": -15, "maximum": 5}
          }
        },
        "split_buy": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["pct", "when"],
            "properties": {
              "pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
              "when": {"enum": ["entry", "drop_pct", "gain_pct"]},
              "value": {"type": ["number", "null"]}
            }
          }
        },
        "split_expire_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 60}
      }
    },

    "exit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "take_profit": {
          "type": "array", "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["gain_pct", "sell_pct"],
            "properties": {
              "gain_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
              "sell_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
            }
          }
        },
        "stop_loss_pct": {"type": ["number", "null"], "minimum": -50, "exclusiveMaximum": 0},
        "trailing_stop_pct": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 50},
        "max_hold_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 250},
        "signal_exit": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["logic", "conditions"],
          "properties": {
            "logic": {"enum": ["all", "any"]},
            "conditions": {"type": "array", "minItems": 1, "maxItems": 10,
                           "items": {"$ref": "#/$defs/condition"}}
          }
        }
      }
    },

    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash_reserve_pct", "max_weight_pct"],
      "properties": {
        "cash_reserve_pct": {"type": "number", "minimum": 0, "maximum": 90},
        "max_weight_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "reentry_cooldown_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 60},
        "halt_if_drawdown_pct": {"type": ["number", "null"], "minimum": 5, "maximum": 90}
      }
    },

    "notes": {"type": ["string", "null"], "maxLength": 500}
  },

  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ind"],
      "properties": {"ind": {"type": "string", "pattern": "^[A-Z_]+$"}},
      "additionalProperties": {"type": ["number", "string"]}
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "op", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/ref"},
        "op": {"enum": [">", ">=", "<", "<=", "==", "cross_above", "cross_below", "between"]},
        "right": {
          "oneOf": [
            {"type": "number"},
            {"$ref": "#/$defs/ref"},
            {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          ]
        }
      }
    }
  }
}
